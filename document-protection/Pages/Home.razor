@page "/"
@using Syncfusion.Blazor.DocumentEditor
@inject IJSRuntime JSRuntime

<div class="sample-header">
    <h1>User based restrict editing and approval workflow in Blazor DOCX Editor</h1>
    <p>
        Select a user to switch between role-based editing restrictions: price-only editing with editable
        ranges, tracked changes review, comments-only review, full editing and read-only access.
    </p>
</div>
<div class="sample-toolbar">
    <div class="permission-holder">
        <table class="permission-table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Role</th>
                    <th>Email</th>
                    <th>Permissions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Nancy</td>
                    <td>Price Editor</td>
                    <td>nancy@example.com</td>
                    <td>Can edit only the price values (marked editable ranges)</td>
                </tr>
                <tr>
                    <td>Andrew</td>
                    <td>Reviewer</td>
                    <td>andrew@example.com</td>
                    <td>All edits are tracked; cannot accept/reject revisions</td>
                </tr>
                <tr>
                    <td>Steven</td>
                    <td>Commenter</td>
                    <td>steven@example.com</td>
                    <td>Can insert comments only; cannot edit content</td>
                </tr>
                <tr>
                    <td>Michael</td>
                    <td>Editor</td>
                    <td>michael@example.com</td>
                    <td>Full editing (approves the tracked changes)</td>
                </tr>
                <tr>
                    <td>Laura</td>
                    <td>Viewer</td>
                    <td>laura@example.com</td>
                    <td>Read-only access to the document</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<div class="sample-toolbar">
    <label for="userSelect">Signed in user:</label>
    <select id="userSelect" value="@selectedEmail" @onchange="OnUserChanged" title="Choose the user whose permissions are applied">
        @foreach (var user in Users)
        {
            <option value="@user.Email">@user.Name</option>
        }
    </select>
    <span id="permissionBanner" class="permission-banner">@bannerText</span>
</div>
<div class="sample-content">
    <div class="editor-holder">
        <SfDocumentEditorContainer @ref="container"
                                  ID="container"
                                  EnableToolbar="true"
                                  Height="590px"
                                  ServiceUrl="https://document.syncfusion.com/web-services/docx-editor/api/documenteditor/">
                <DocumentEditorContainerEvents Created="OnCreated"></DocumentEditorContainerEvents>
        </SfDocumentEditorContainer>
    </div>
</div>

<style>
    .sample-header {
        padding: 16px 24px 8px;
        background-color: #ffffff;
        border-bottom: 1px solid #e0e0e0;
    }

    .sample-header h1 {
        margin: 0 0 4px;
        font-size: 20px;
        font-weight: 600;
        color: #1a202c;
    }

    .sample-header p {
        margin: 0;
        font-size: 13px;
        color: #5f6b7a;
    }

    .sample-toolbar {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 24px;
        background-color: #ffffff;
        border-bottom: 1px solid #e0e0e0;
    }

    .sample-toolbar label {
        font-size: 13px;
        font-weight: 600;
        color: #1a202c;
    }

    .sample-toolbar select {
        min-width: 160px;
        height: 30px;
        padding: 2px 6px;
        border: 1px solid #c3cdd5;
        border-radius: 4px;
        font-size: 13px;
    }

    .permission-banner {
        font-size: 12px;
        color: #5f6b7a;
    }

    .sample-content {
        display: flex;
        align-items: flex-start;
    }

    .editor-holder {
        flex: 1;
        min-width: 0;
    }

    .permission-holder {
        flex: 1;
        padding: 0;
    }

    .permission-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
    }

    .permission-table th,
    .permission-table td {
        padding: 6px 8px;
        border: 1px solid #e0e0e0;
        text-align: left;
        vertical-align: top;
    }

    .permission-table th {
        background-color: #f4f5f7;
        font-weight: 600;
        color: #1a202c;
    }

    .permission-table td:nth-child(3) {
        word-break: break-all;
    }
</style>

@code {
    private SfDocumentEditorContainer? container;

    public class UserInfo
    {
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
        public string ProtectionType { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }

    private readonly List<UserInfo> Users = new()
    {
        new UserInfo { Name = "Nancy", Email = "nancy@example.com", Role = "Price Editor", ProtectionType = "ReadOnly", Description = "Can edit only the price values (editable ranges marked in the document)" },
        new UserInfo { Name = "Andrew", Email = "andrew@example.com", Role = "Reviewer", ProtectionType = "RevisionsOnly", Description = "All edits are tracked as revisions; cannot accept or reject revisions" },
        new UserInfo { Name = "Steven", Email = "steven@example.com", Role = "Commenter", ProtectionType = "CommentsOnly", Description = "Can insert comments only; cannot edit document content" },
        new UserInfo { Name = "Michael", Email = "michael@example.com", Role = "Editor", ProtectionType = "NoProtection", Description = "Full editing access on the entire document" },
        new UserInfo { Name = "Laura", Email = "laura@example.com", Role = "Viewer", ProtectionType = "ReadOnly", Description = "Read-only access to the document" }
    };

    private string selectedEmail = "nancy@example.com";
    private string bannerText = "Signed in as Nancy (nancy@example.com) - Price Editor";

    public async void OnCreated(object args)
    {
        if (container != null)
        {
            SfDocumentEditor documentEditor = container.DocumentEditor;
            if (documentEditor != null)
            {
                await documentEditor.OpenAsync(Data.ProtectedData);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("documentEditorInterop.initWorkflow", "container", selectedEmail);
        }
    }

    private async Task OnUserChanged(ChangeEventArgs e)
    {
        var email = e.Value?.ToString() ?? string.Empty;
        var user = Users.FirstOrDefault(u => u.Email == email);
        if (user != null)
        {
            selectedEmail = user.Email;
            bannerText = $"Signed in as {user.Name} ({user.Email}) - {user.Role}";
            await JSRuntime.InvokeVoidAsync("documentEditorInterop.applyUserPermissions", "container", user.Email, user.ProtectionType);
        }
    }
}
